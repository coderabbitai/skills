{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "coderabbit": {
      "type": "streamable-http",
      "url": "https://mcp.coderabbit.ai/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "connection"
            ],
            "defaultScopes": [
              "account:read",
              "usage:read",
              "pull_requests:read",
              "repositories:read",
              "review",
              "reviews:write",
              "code:read",
              "code:write",
              "triage:read",
              "triage:write",
              "security:read",
              "security:write",
              "configuration:read",
              "configuration:write",
              "connections:read",
              "connections:write",
              "knowledge:read",
              "knowledge:write",
              "reports:read",
              "reports:write",
              "verify:read",
              "verify:write",
              "automations:read",
              "automations:write"
            ]
          }
        }
      }
    }
  }
}
