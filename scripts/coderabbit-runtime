#!/bin/sh
# A pinned plugin dependency, separate from the user's standalone CLI.
set -eu
caller_path=${PATH-/usr/bin:/bin:/usr/sbin:/sbin}
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
# This dependency is updated by plugin releases, using the CLI's existing
# managed-install contract. The user's standalone process keeps its settings.
export CODERABBIT_CLI_DISABLE_AUTO_UPDATE=true
export CODERABBIT_CLI_UPDATE_MANAGED=true
fail() { printf '%s\n' "CodeRabbit: $*" >&2; exit 1; }
plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
case "$(uname -s):$(uname -m)" in
  Darwin:arm64) platform=darwin-arm64 ;;
  Darwin:x86_64) platform=darwin-x64 ;;
  Linux:aarch64|Linux:arm64) platform=linux-arm64 ;;
  Linux:x86_64) platform=linux-x64 ;;
  *) fail 'This operating system or processor is not supported by this package.' ;;
esac
metadata="$plugin_root/runtime"
version=$(cat "$metadata/version")
expected=$(cat "$metadata/$platform.sha256" 2>/dev/null) ||
  fail "This package has no pinned $platform runtime."
case "$expected" in *[!a-f0-9]*|'') fail 'The runtime checksum is invalid.' ;; esac
[ "${#expected}" -eq 64 ] || fail 'The runtime checksum is invalid.'
if [ "${1-}" = --data-dir ]; then
  [ "$#" -ge 3 ] || fail 'Expected --data-dir DIRECTORY followed by a command.'
  data_root=$2
  shift 2
else
  [ -n "${HOME-}" ] || fail 'A home directory or explicit --data-dir is required.'
  data_root="${XDG_CACHE_HOME:-$HOME/.cache}/coderabbit/plugin-runtime"
fi
case "$data_root" in /*) ;; *) fail 'The runtime data directory must be absolute.' ;; esac
directory="$data_root/$version/$platform"
binary="$directory/coderabbit"
digest() {
  if command -v shasum >/dev/null 2>&1; then
    value=$(shasum -a 256 "$1")
  elif command -v sha256sum >/dev/null 2>&1; then
    value=$(sha256sum "$1")
  else
    fail 'A system SHA-256 utility is required.'
  fi
  printf '%s\n' "${value%% *}"
}
verified() {
  [ -f "$binary" ] && [ ! -L "$binary" ] && [ -x "$binary" ] &&
    [ "$(digest "$binary")" = "$expected" ]
}
require_mcp() {
  "$1" mcp-hook --help >/dev/null 2>&1 ||
    fail 'The pinned CLI does not support MCP review. Install a compatible CodeRabbit plugin package.'
}
case "${1-}" in
  --prepare)
    [ "$#" -eq 1 ] || fail 'Runtime preparation takes no review options.'
    if verified; then
      require_mcp "$binary"
    else
      command -v curl >/dev/null 2>&1 || fail 'Install curl before preparing the CLI.'
      command -v unzip >/dev/null 2>&1 || fail 'Install unzip before preparing the CLI.'
      url=$(cat "$metadata/$platform.url")
      archive_sha=$(cat "$metadata/$platform.archive.sha256")
      umask 077
      [ ! -L "$data_root" ] && [ ! -L "$directory" ] && [ ! -L "$binary" ] ||
        fail 'Refusing a symbolic link in the runtime installation target.'
      mkdir -p "$directory"
      stage=$(mktemp -d "$directory/.prepare.XXXXXX")
      trap 'rm -rf -- "$stage"' 0
      trap 'exit 1' HUP INT TERM
      curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
        --connect-timeout 30 --max-time 300 --max-filesize 104857600 \
        --output "$stage/native.zip" "$url" || fail 'CLI download failed; no runtime was installed.'
      [ "$(digest "$stage/native.zip")" = "$archive_sha" ] || fail 'CLI archive checksum mismatch; no runtime was installed.'
      unzip -p "$stage/native.zip" coderabbit > "$stage/coderabbit" || fail 'The CLI archive has no executable.'
      [ "$(digest "$stage/coderabbit")" = "$expected" ] || fail 'CLI executable checksum mismatch; no runtime was installed.'
      chmod 700 "$stage/coderabbit"
      require_mcp "$stage/coderabbit"
      mv -f -- "$stage/coderabbit" "$binary"
    fi
    "$binary" --version
    exit 0 ;;
  mcp-upload|mcp-hook|--version|config) ;;
  review)
    [ "${2-}" = --agent ] && [ "${3-}" = --mcp-stdin ] ||
      fail 'Use review --agent --mcp-stdin [--dir WORKSPACE] with the connected review skill.'
    case "$#" in
      3) ;;
      5) [ "$4" = --dir ] && [ -n "$5" ] || fail 'Expected --dir WORKSPACE.' ;;
      *) fail 'Review options come from the MCP handoff; only --dir WORKSPACE is accepted locally.' ;;
    esac ;;
  *) fail 'Use CodeRabbit setup to prepare the CLI, then the connected review skill.' ;;
esac
verified || fail 'The pinned CLI is missing or corrupt. Run CodeRabbit setup before starting a review; no download or review was attempted.'
if [ "$1" != --version ] && [ "$1" != config ]; then
  CODERABBIT_MCP_URL=$(cat "$metadata/mcp-url")
  export CODERABBIT_MCP_URL
  case "$1" in
    mcp-upload|mcp-hook)
      CR_CLI_ALLOW_UNTRUSTED_HOST_URL=true
      export CR_CLI_ALLOW_UNTRUSTED_HOST_URL ;;
  esac
fi
# Verification uses system helpers; the CLI uses the caller's Git and SSH tools.
PATH=$caller_path exec "$binary" "$@"
